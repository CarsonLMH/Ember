{
  "name": "ember",
  "private": true,
  "license": "MIT",
  "version": "1.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook dev -p 6006 --host 127.0.0.1 --no-open",
    "storybook:build": "STORYBOOK_DISABLE_TELEMETRY=1 storybook build",
    "test": "vitest run --exclude '.claude/**'",
    "test:harness": "node tests/agent-harness/run.mjs",
    "tauri": "tauri",
    "tauri:mcp": "tauri dev --features mcp --config src-tauri/tauri.mcp.conf.json",
    "e2e:build": "VITE_E2E=1 tauri build --debug --no-bundle --features e2e --config src-tauri/tauri.e2e.conf.json",
    "e2e": "wdio run e2e/wdio.conf.ts",
    "e2e:visual": "EMBER_E2E_VISIBLE=1 wdio run e2e/wdio.conf.ts --spec e2e/specs/07-visual.e2e.ts",
    "e2e:visual:update": "EMBER_UPDATE_VISUAL_BASELINES=1 npm run e2e:visual",
    "e2e:perf": "EMBER_E2E_PERF=1 wdio run e2e/wdio.conf.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@axe-core/webdriverio": "^4.13.0",
    "@hypothesi/tauri-mcp-cli": "^0.12.0",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-mcp": "^0.7.0",
    "@storybook/addon-vitest": "10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@wdio/cli": "^9.30.1",
    "@wdio/local-runner": "^9.30.1",
    "@wdio/mocha-framework": "^9.30.1",
    "@wdio/spec-reporter": "^9.30.1",
    "@wdio/tauri-plugin": "^1.3.0",
    "@wdio/tauri-service": "^1.3.0",
    "@wdio/visual-service": "^9.3.0",
    "storybook": "10.5.10",
    "tsx": "^4.23.11",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "valibot": "1.4.2"
  }
}
