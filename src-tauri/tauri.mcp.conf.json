{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": [
        "default",
        {
          "identifier": "mcp",
          "description": "MCP bridge permissions — this overlay is only ever passed to builds with the `mcp` cargo feature",
          "windows": ["main"],
          "permissions": ["mcp-bridge:default"]
        }
      ]
    }
  }
}
